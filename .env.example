# ==============================================================================
# School Management System (SMS) - Environment Configuration Example
# Copy this file to .env and fill in production secrets. NEVER commit .env!
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000

# Database Configuration
# Set DB_DRIVER=mysql for MySQL/MariaDB in staging & production.
# Set DB_DRIVER=sqlite (or DB_AUTO_FALLBACK=true) for zero-daemon local preview/testing.
DB_DRIVER=mysql
DB_AUTO_FALLBACK=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_management
DB_USER=sms_app_user
DB_PASSWORD=change_me_strong_db_password
DB_CONNECTION_LIMIT=10
SQLITE_PATH=./data/sms_dev.sqlite

# Session Security
SESSION_SECRET=replace_with_at_least_32_random_characters_in_production
SESSION_COOKIE_NAME=sms.sid
SESSION_MAX_AGE_MS=28800000

# Real-Time Google OAuth 2.0 (Blueprint Revision 2.1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_AUTO_LINK_VERIFIED_EMAIL=true

# One-Time Code (OTP) Sign-In delivery (optional outbound gateways)
# Leave blank to run in interactive sandbox mode (non-production): the 6-digit code is shown on screen
# and written to the server log instead of being emailed/texted. Point these at any HTTPS endpoint that
# accepts { to, channel, code, subject, message, fullName } to deliver real codes.
OTP_EMAIL_WEBHOOK_URL=
OTP_SMS_WEBHOOK_URL=
OTP_CODE_TTL_SECONDS=600

# Paystack Payment Gateway (Financial Dashboard & Student Fee Checkout)
# Add your Paystack keys (pk_test_... / sk_test_... or pk_live_... / sk_live_...).
# When empty in local development, interactive Paystack Sandbox Checkout is enabled automatically.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/financial

# Default Initial School Currency & Timezone
DEFAULT_CURRENCY_CODE=GHS
DEFAULT_CURRENCY_SYMBOL=GH₵
SCHOOL_TIMEZONE=Africa/Accra

# Keep database clean by default (only set to true to populate sample demo records)
AUTO_SEED_DEMO=false
SUPERADMIN_INITIAL_EMAIL=admin@school.edu.gh
SUPERADMIN_INITIAL_PASSWORD=ChangeMe@2026!
